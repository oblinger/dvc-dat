#!/bin/sh
# dat -- the dat command from any directory, without activating an environment.
#
#   dat TARGET [ARG ...] [KEY=VALUE ...]     dat list | info | version | --help
#
# Walks up from $PWD to the nearest .dataconfig.yaml, picks an interpreter
# ($DAT_PYTHON, else the config's `python:` key, else .venv beside the config,
# else python3 on PATH), and execs `python -m dvc_dat "$@"` with the working
# directory unchanged.  With an environment active, the console script of the
# same name shadows this copy and does the same thing.
# Exit 3 when no .dataconfig.yaml is above the working directory.

# -- the nearest .dataconfig.yaml, git style ---------------------------------
dir=$PWD
while [ ! -f "$dir/.dataconfig.yaml" ]; do
    [ "$dir" = "/" ] && {
        echo "dat: no .dataconfig.yaml in $PWD or any parent" >&2
        exit 3
    }
    dir=$(dirname "$dir")
done

# -- the config's `python:` key: one top-level line, no YAML parser needed ----
cfg_python=$(sed -n 's/^python:[[:space:]]*//p' "$dir/.dataconfig.yaml" | head -n 1 |
    sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/")

# -- pick the interpreter -----------------------------------------------------
if [ -n "$DAT_PYTHON" ]; then
    python=$DAT_PYTHON
elif [ -n "$cfg_python" ]; then
    case $cfg_python in
        /*) python=$cfg_python ;;         # absolute, as written
        *) python=$dir/$cfg_python ;;     # relative to the config folder
    esac
elif [ -x "$dir/.venv/bin/python" ]; then
    python=$dir/.venv/bin/python
else
    python=python3
fi

# A folder means the venv holding it.
[ -d "$python" ] && python=$python/bin/python

case $python in
    */*)
        [ -x "$python" ] || {
            echo "dat: $python is not an executable interpreter" >&2
            exit 1
        } ;;
    *)
        command -v "$python" >/dev/null 2>&1 || {
            echo "dat: $python is not on PATH" >&2
            exit 1
        } ;;
esac

exec "$python" -m dvc_dat "$@"
